# ========================================================
# Portfolio Backend Configuration Template
# ========================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ========================================================
# PostgreSQL Database Configuration
# ========================================================
# OPTION 1: Full Database URL (Recommended for Local or Cloud)
# Local Example: postgresql://postgres:your_password@localhost:5432/portfolio_db
# Cloud Example (Neon/Supabase): postgresql://user:pass@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# OPTION 2: Individual Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=portfolio_db
PGSSL=false

# ========================================================
# Email Notification Alerts (Nodemailer)
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sonkerlucky5@gmail.com
SMTP_PASS=
NOTIFICATION_EMAIL=sonkerlucky5@gmail.com
