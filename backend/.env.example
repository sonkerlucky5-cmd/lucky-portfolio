PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection URL
# Local Example: postgresql://postgres:postgres@localhost:5432/portfolio_db
# Cloud Example (Neon/Supabase): postgresql://user:password@ep-host.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db

# Individual Parameters (Fallback)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=portfolio_db
PGSSL=false

# Email Notification Alerts (Optional - Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sonkerlucky5@gmail.com
SMTP_PASS=
NOTIFICATION_EMAIL=sonkerlucky5@gmail.com
