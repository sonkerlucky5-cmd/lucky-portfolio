# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173

# Database (Optional - MongoDB Atlas or local MongoDB)
# If left empty, the server automatically uses local JSON store fallback
MONGODB_URI=

# Email Notifications (Optional - Nodemailer SMTP credentials)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=sonkerlucky5@gmail.com

