# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ========================================================
# PostgreSQL Database Configuration
# ========================================================
# Option 1: Full Connection String (Local or Cloud like Neon/Supabase/Render)
# Example Local: postgresql://postgres:password@localhost:5432/portfolio_db
# Example Neon/Supabase: postgresql://user:pass@ep-cool-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio_db

# Option 2: Individual Parameters (if not using DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=portfolio_db
PGSSL=false

# Note: If PostgreSQL is not running or credentials are empty, the backend
# automatically uses the built-in local JSON fallback without crashing!

# ========================================================
# Email Notifications (Optional - Nodemailer SMTP)
# ========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=sonkerlucky5@gmail.com
